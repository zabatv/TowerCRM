# Database (PostgreSQL - for production, use via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/towercrm?schema=public"

# For local SQLite development, change prisma/schema.prisma provider to "sqlite"
# DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-random-secret-string"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
