generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("teacher")
  branchId     String?  @map("branch_id")
  branch       Branch?  @relation("BranchUsers", fields: [branchId], references: [id])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedLeads  Lead[]
  teacherLessons Lesson[]
  teacherGroups  Group[]
  enrollments    Enrollment[]
  activityLogs   ActivityLog[]
  managedBranch  Branch?     @relation("BranchManager")
  attendance     Attendance[]
  notifications  Notification[]

  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  managerId String?  @unique @map("manager_id")
  manager   User?    @relation("BranchManager", fields: [managerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users   User[]   @relation("BranchUsers")
  leads   Lead[]
  lessons Lesson[]
  groups  Group[]

  @@map("branches")
}

model Lead {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  source     String?
  status     String   @default("new")
  assignedTo String?  @map("assigned_to")
  assigned   User?    @relation(fields: [assignedTo], references: [id])
  branchId   String?  @map("branch_id")
  branch     Branch?  @relation(fields: [branchId], references: [id])
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("leads")
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  description String?
  dateTime    DateTime @map("date_time")
  duration    Int      @default(60)
  teacherId   String?  @map("teacher_id")
  teacher     User?    @relation(fields: [teacherId], references: [id])
  groupId     String?  @map("group_id")
  group       Group?   @relation(fields: [groupId], references: [id])
  branchId    String?  @map("branch_id")
  branch      Branch?  @relation(fields: [branchId], references: [id])
  status      String   @default("scheduled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attendance Attendance[]

  @@map("lessons")
}

model Group {
  id            String   @id @default(uuid())
  name          String
  course        String?
  level         String?
  branchId      String?  @map("branch_id")
  branch        Branch?  @relation(fields: [branchId], references: [id])
  teacherId     String?  @map("teacher_id")
  teacher       User?    @relation(fields: [teacherId], references: [id])
  schedule      String?
  capacity      Int      @default(10)
  enrolledCount Int      @default(0) @map("enrolled_count")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("groups")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  groupId    String?  @map("group_id")
  group      Group?   @relation(fields: [groupId], references: [id])
  status     String   @default("active")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("enrollments")
}

model Attendance {
  id        String   @id @default(uuid())
  lessonId  String?  @map("lesson_id")
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  status    String   @default("present")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("attendance")
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  details    String?
  timestamp  DateTime @default(now())

  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String?
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
